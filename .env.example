# ─── Convex ───────────────────────────────────────────────────────────────────
# URL deployment Convex (dari Convex dashboard → Settings)
NEXT_PUBLIC_CONVEX_URL=https://<your-deployment>.convex.cloud

# URL HTTP actions Convex (biasanya sama tapi pakai .site di akhir)
CONVEX_SITE_URL=https://<your-deployment>.convex.site

# Deploy key untuk CI/CD dan Vercel build (dari Convex dashboard → Settings → Deploy Keys)
CONVEX_DEPLOY_KEY=prod:...

# ─── Better Auth ──────────────────────────────────────────────────────────────
# Secret acak minimal 32 karakter (generate: openssl rand -base64 32)
BETTER_AUTH_SECRET=change_me_to_a_random_secret

# ─── App ──────────────────────────────────────────────────────────────────────
# URL publik aplikasi (tanpa trailing slash)
# Development: http://localhost:5000
# Production:  https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:5000
